# =============================================================================
# Vantera — environment configuration example
# Copy to .env.local for development. NEVER commit real values to Git.
# Values below are PLACEHOLDERS ONLY.
# =============================================================================

# --- Supabase (public, safe for the browser bundle) --------------------------
# Project URL: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable "anon" key. Safe for browser use ONLY because Row Level Security
# policies protect all private data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (SERVER ONLY — never expose to the browser) --------------------
# Secret service-role key. Bypasses RLS; used only in trusted server code
# (payment review, card uploads, audit logging). Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Site ---------------------------------------------------------------------
# Canonical public URL of the deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Transactional email (optional until configured) --------------------------
# Emails are logged but NOT delivered until a provider key is configured.
# Supported provider: Resend (https://resend.com). Create an API key + verify
# your sending domain, then set:
EMAIL_PROVIDER=resend
EMAIL_FROM="Vantera <memberships@your-domain.example>"
RESEND_API_KEY=re_your_resend_api_key_here

# --- Business inbox for contact form messages ---------------------------------
CONTACT_INBOX=memberships@your-domain.example
